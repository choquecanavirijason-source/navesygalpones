# ─── Públicas (se exponen al navegador) ───────────────────────────────
# URL canónica del sitio. Se usa en metadata, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Solo servidor (nunca usar el prefijo NEXT_PUBLIC_) ───────────────
# Backend externo consumido por apiClient desde app/api/*
API_BASE_URL=
API_TIMEOUT_MS=10000
API_TOKEN=

# Nivel mínimo del logger: debug | info | warn | error
LOG_LEVEL=info

# ─── Correo saliente del formulario de contacto ───────────────────────
# Hacen falta las tres (HOST, USER y PASSWORD) para que haya envío real.
# Sin ellas, en desarrollo el correo solo se escribe en el log; en producción
# el endpoint responde 503 en vez de aceptar la consulta y perderla.
#
# Hostinger (casilla del propio dominio, recomendado: SPF y DKIM ya alineados):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_USER=info@nygestructuras.com
#   SMTP_PASSWORD=<contraseña de la casilla>
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<cuenta>,
# SMTP_PASSWORD=<contraseña de aplicación, no la del correo>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Remitente del mensaje. Si se omite, se usa SMTP_USER.
# Formato con nombre visible: MAIL_FROM="NyG Estructuras <info@nygestructuras.com>"
MAIL_FROM=

# Buzón que recibe las consultas.
CONTACT_TO=info@nygestructuras.com
