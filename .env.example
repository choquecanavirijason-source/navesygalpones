# ─── Públicas (se exponen al navegador) ───────────────────────────────
# URL canónica del sitio. Se usa en metadata, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Solo servidor (nunca usar el prefijo NEXT_PUBLIC_) ───────────────
# Backend externo consumido por apiClient desde app/api/*
API_BASE_URL=
API_TIMEOUT_MS=10000
API_TOKEN=

# Nivel mínimo del logger: debug | info | warn | error
LOG_LEVEL=info
